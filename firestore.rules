rules_version = '2';

// Leaderboard security rules.
// - Anyone authenticated (incl. anonymous) can READ the boards.
// - A player can only WRITE their own document (doc id == their uid).
// - Score must be a non-negative int and name a short string. This blocks the
//   most basic tampering; for a competitive game move score submission behind a
//   Cloud Function / App Check for real anti-cheat.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validScore() {
      return request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 1000000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24;
    }

    match /scores/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) && validScore();
    }

    match /daily/{day}/scores/{uid} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) && validScore();
    }
  }
}
